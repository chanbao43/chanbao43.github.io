---
// Footer.astro — 底部信息栏
import { SITE } from "../config";
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-links">
      <a href="/rss.xml" target="_blank" rel="noopener">RSS 订阅</a>
      {SITE.social.github && <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>}
    </div>
    <div class="footer-info">
      <span>&copy; {new Date().getFullYear()} {SITE.author}</span>
      <span class="separator">·</span>
      <span>由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 驱动</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    color: var(--color-text-secondary);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-info {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }

  .separator {
    color: var(--color-border);
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
