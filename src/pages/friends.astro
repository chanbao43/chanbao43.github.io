---
// friends.astro — 友情链接页面
import Layout from "../layouts/Layout.astro";
import friends from "../data/friends.json";
---

<Layout title="友情链接" description="一些有趣的站点和朋友们的博客">
  <h1 class="page-title">友情链接</h1>
  <p class="page-desc">一些有趣的站点和朋友们的博客，欢迎互加友链～</p>

  {friends.length === 0 ? (
    <p class="empty-text">暂无友链</p>
  ) : (
    <div class="friends-grid">
      {friends.map((friend) => (
        <a href={friend.url} class="friend-card" target="_blank" rel="noopener">
          {friend.avatar && (
            <img
              src={friend.avatar}
              alt={friend.name}
              class="friend-avatar"
              loading="lazy"
            />
          )}
          <div class="friend-info">
            <h2 class="friend-name">{friend.name}</h2>
            <p class="friend-desc">{friend.description}</p>
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>

<style>
  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .page-desc {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .empty-text {
    text-align: center;
    color: var(--color-text-secondary);
    padding: 3rem 0;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: all var(--transition);
  }

  .friend-card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-secondary);
  }

  .friend-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .friend-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.15em;
  }

  .friend-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .friends-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
